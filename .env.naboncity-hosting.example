# ใช้เมื่อรัน Scraper อยู่บน Server เดียวกับเว็บไซต์/ฐานข้อมูลเดิม
# ห้ามนำไฟล์ .env ที่ใส่รหัสผ่านจริงขึ้น Git หรือส่งต่อ
DATABASE_MODE=required
MYSQL_AUTO_START=false

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=nabonct_usr
MYSQL_PASSWORD=PUT_PASSWORD_FROM_CONNDB_HERE

MYSQL_DATABASE_MODE=fixed
MYSQL_DATABASE=nabonct_cjworld
MYSQL_CREATE_DATABASE=false

MYSQL_DATABASE_CHARSET=tis620
MYSQL_DATABASE_COLLATION=tis620_thai_ci
MYSQL_TABLE_CHARSET=tis620
MYSQL_TABLE_COLLATION=tis620_thai_ci
MYSQL_CONNECTION_CHARSET=TIS620_THAI_CI
MYSQL_TIS620_SANITIZE=true

STORE_PDF_IN_DB=true
PDF_DB_MAX_MB=32
APP_PORT=3000
