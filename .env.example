MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# per_site = สร้างฐาน scrape_<ชื่อเว็บไซต์> แยกแต่ละงาน
# fixed    = เก็บทุกงานลงฐานเดียวตาม MYSQL_DATABASE เช่นฐานเดิมจาก conndb.php
MYSQL_DATABASE_MODE=per_site
MYSQL_DATABASE=
MYSQL_CREATE_DATABASE=true

# ค่า default ของฐานและตารางใหม่
MYSQL_DATABASE_CHARSET=utf8mb4
MYSQL_DATABASE_COLLATION=utf8mb4_unicode_ci
MYSQL_TABLE_CHARSET=utf8mb4
MYSQL_TABLE_COLLATION=utf8mb4_unicode_ci
MYSQL_CONNECTION_CHARSET=UTF8MB4_UNICODE_CI
# true = ตัดอักขระที่ TIS-620 เก็บไม่ได้ก่อน INSERT (เปิดเมื่อใช้ตาราง tis620)
MYSQL_TIS620_SANITIZE=false

APP_PORT=3000
LINE_NOTIFY_TOKEN=

# เวลาพักก่อนเริ่มส่วนถัดไป (จัดซื้อฯ / ประชาสัมพันธ์ / ภาพกิจกรรม / หัวข้อเพิ่มเติม)
# แต่ละส่วนมีการหน่วงต่อ request อยู่แล้ว ค่านี้จึงเป็นเพียงช่วงพักระหว่างส่วน
# 0 = ไม่หน่วงเลย, สูงสุด 600000 (10 นาที)
# หมายเหตุ: หัวข้อเพิ่มเติมนับเป็นส่วนละ 1 ช่วงพัก ถ้ามีหลายหัวข้อควรตั้งค่าต่ำ
SECTION_DELAY_MS=20000

# Browser fallback สำหรับเว็บไซต์ที่ตอบ HTTP 403
# auto = ลอง HTTP ก่อน แล้วเชื่อม Chrome port 9222 หรือเปิด Chrome ใหม่อัตโนมัติ
BROWSER_MODE=auto
BROWSER_CDP_URL=http://127.0.0.1:9222
BROWSER_HEADLESS=false
BROWSER_TIMEOUT_MS=90000
# หน้า HTML: รอเพียง response commit และ DOM ระยะสั้น แล้วหยุด resource/iframe ที่โหลดค้าง
BROWSER_HTML_COMMIT_TIMEOUT_MS=20000
BROWSER_DOM_READY_TIMEOUT_MS=7000
BROWSER_PAGE_SETTLE_MS=1200
# การปิดแท็บ Worker ห้ามบล็อกงานเกินเวลานี้
BROWSER_TAB_CLOSE_TIMEOUT_MS=2500
BROWSER_CHALLENGE_WAIT_SECONDS=90
BROWSER_LAZY_SCROLL_ROUNDS=8
BROWSER_IN_PAGE_MAX_FILE_MB=50
BROWSER_IMAGE_RENDER_TIMEOUT_MS=30000
BROWSER_IMAGE_CANVAS_MAX_PIXELS=40000000
BROWSER_NETWORK_MAX_FILE_MB=100
BROWSER_ELEMENT_SCREENSHOT_MIN_BYTES=1500
# BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# BROWSER_PROFILE_DIR=C:\nabon-scraper-profile

# false = ดาวน์โหลดเฉพาะไฟล์โดเมนเดียวกับข่าว ป้องกันลิงก์ภายนอกปะปน
# true = อนุญาตไฟล์จาก CDN/โดเมนภายนอก เช่น วิดีโอหรือเอกสารที่เว็บไซต์ฝังไว้
ALLOW_EXTERNAL_ASSETS=false


# ระบบตรวจสอบไฟล์แนบทำงานอัตโนมัติและสร้าง CSV/JSON ทุกครั้ง
# false = ข้ามไฟล์ที่อยู่นอกโดเมนข่าว แต่ยังบันทึกสถานะ skipped_external ในรายงาน

# จับรูปที่ Chrome แสดงจริง ใช้แทน URL ต้นฉบับที่ถูก Hotlink Protection/403
BROWSER_CAPTURE_MIN_WIDTH=100
BROWSER_CAPTURE_MIN_HEIGHT=70
BROWSER_ELEMENT_SCREENSHOT_MIN_BYTES=1200

# เก็บไฟล์ PDF ลง MySQL ใน column pdf_data (LONGBLOB)
STORE_PDF_IN_DB=true
# จำกัดขนาด PDF ต่อไฟล์เพื่อไม่ให้เกิน max_allowed_packet ของ MySQL
PDF_DB_MAX_MB=32


# สื่อกิจกรรม/ข่าวที่รองรับ: รูป, MP4/WebM/MOV, MP3/WAV, เอกสาร และ embed video
# YouTube/Vimeo/Facebook/TikTok จะเก็บ embed_url เป็น reference ในฐานข้อมูล

# Vendor Adapter detection
VENDOR_DETECTION_MIN_SCORE=60
VENDOR_DETECTION_PROBE_LIMIT=8

# Full public-site migration mode
# Uses a visible Chrome session. Cloudflare/CAPTCHA must be completed manually in Chrome.
MIGRATION_MAX_PAGES=1000
MIGRATION_MAX_ASSETS=10000
MIGRATION_MAX_DEPTH=12
MIGRATION_REQUEST_DELAY_MS=700
MIGRATION_MAX_FILE_MB=500
MIGRATION_INCLUDE_EXTERNAL_ASSETS=true
MIGRATION_RESUME=true

# การใช้งานฐานข้อมูล
# auto     = พยายามเปิด MySQL/XAMPP อัตโนมัติ หากยังไม่ได้ให้ดึงข้อมูลต่อแบบเก็บไฟล์อย่างเดียว
# required = ต้องเชื่อม MySQL ได้เท่านั้น มิฉะนั้นหยุดงาน
# disabled = ไม่ใช้ MySQL และเก็บทุกอย่างลง downloads เท่านั้น
DATABASE_MODE=auto

# Windows/XAMPP: ให้ระบบลองเปิด mysql_start.bat อัตโนมัติเมื่อพอร์ต 3306 ยังไม่พร้อม
MYSQL_AUTO_START=true
XAMPP_DIR=C:\xampp
MYSQL_CONNECT_TIMEOUT_MS=4000
MYSQL_START_RETRY_COUNT=12
MYSQL_START_RETRY_DELAY_MS=2000

# URL ที่โปรแกรมต้องข้ามโดยไม่ส่ง HTTP request และไม่เปิดผ่าน Chrome
# คั่นหลายโดเมนด้วย comma เช่น info.go.th,example.go.th
SCRAPER_SKIP_HOSTS=info.go.th
# ข้าม URL ที่มีข้อความกำหนด (คั่นด้วย comma) ปล่อยว่างได้
SCRAPER_SKIP_URL_CONTAINS=
# เปิดรายการข้ามมาตรฐานของระบบ ซึ่งมี info.go.th อยู่แล้ว
SCRAPER_USE_DEFAULT_SKIP_HOSTS=true

# จำนวนหน้ารายละเอียดที่ดึงพร้อมกัน (1 = ทีละรายการ, สูงสุด 16)
# ยิ่งสูงยิ่งเร็ว แต่เสี่ยงโดนเว็บปลายทาง rate-limit / 403 มากขึ้น
SCRAPE_CONCURRENCY=1

# เพดานจำนวนหน้าอ้างอิงที่เก็บ cache ไว้ กันหน่วยความจำโตไม่หยุด
BROWSER_REFERER_CACHE_MAX=8

# แท็บ Chrome ที่ใช้ซ้ำได้ ลดการเปิดแท็บใหม่ที่แย่งโฟกัสผู้ใช้ (0 = แบบเดิม)
BROWSER_PAGE_POOL_MAX=4

# false = ปิด fallback ที่ต้องถ่าย screenshot (Playwright ต้องดันแท็บขึ้นหน้าสุดก่อนถ่าย)
BROWSER_ALLOW_SCREENSHOT_FALLBACK=true
